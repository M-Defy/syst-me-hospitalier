# Copiez ce fichier en ".env" et adaptez les valeurs à votre environnement.

# Clé secrète Django (générer une valeur unique en production).
DJANGO_SECRET_KEY=changez-moi-en-production

# "True" en développement, "False" en production.
DJANGO_DEBUG=True

# Liste d'hôtes autorisés séparés par des virgules (ex: "monsite.com,api.monsite.com").
DJANGO_ALLOWED_HOSTS=*

# Origines autorisées pour le frontend React (CORS), séparées par des virgules.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chaîne de connexion PostgreSQL. Si absente, une base SQLite locale
# (db.sqlite3) est utilisée en secours pour le développement.
# Exemple : postgres://sih_user:sih_password@localhost:5432/sih
DATABASE_URL=postgres://sih_user:sih_password@localhost:5432/sih
